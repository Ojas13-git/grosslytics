---
import Page from '../layouts/Page.astro';
---

<Page title="Page not found — Grosslytics" description="The requested page could not be found on Grosslytics." noindex>
	<main class="mx-auto max-w-[640px] px-5 pt-20 pb-28 text-center">
		<p class="eyebrow mb-3">404</p>
		<h1 class="text-[clamp(34px,5vw,48px)] font-semibold leading-[1.08] tracking-[-0.03em]">Page not found.</h1>
		<p class="mt-4 text-[17px] leading-relaxed text-ink-2">
			That address does not exist or may have moved. Try one of the main sections below.
		</p>
		<div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
			<a href="/" class="btn btn-primary">Go home</a>
			<a href="/docs/" class="btn-quiet text-[16px]">Read the docs ›</a>
			<a href="/compare/" class="btn-quiet text-[16px]">Compare tools ›</a>
			<a href="/tools/payment-fee-calculator/" class="btn-quiet text-[16px]">Fee calculator ›</a>
		</div>
	</main>
</Page>
