---
import Page from '../../layouts/Page.astro';
import SchemaJsonLd from '../../components/seo/SchemaJsonLd.astro';
import RoiCalculator from '../../components/marketing/RoiCalculator.tsx';

export const prerender = true;

export function getStaticPaths() {
	// getStaticPaths runs in isolation, so its constants live inside it
	return [
		{
			params: { slug: 'ga4-alternative' },
			props: {
				competitor: 'Google Analytics 4',
				title: 'GA4 vs Grosslytics for SaaS Revenue Attribution',
				description: 'Compare GA4 purchase events with Grosslytics payment webhooks. See what each tool measures and how to verify revenue by channel before switching.',
				h1: 'GA4 vs Grosslytics for SaaS revenue attribution',
				answer: 'Keep GA4 if you use Google Ads conversions, BigQuery export or web and app analytics. Grosslytics is an option if your main question is which traffic sources lead to payments in Stripe or Paddle. GA4 reports the purchase events you send it. Grosslytics records payment webhooks and credits a source when it can match the payment to a tracked visitor.',
				whatIs: 'Google Analytics 4 is Google’s event-based analytics for websites and apps. It offers audiences, explorations and integrations with Google Ads, Search Console and BigQuery. Standard properties offer 2 or 14 months of user-level retention. That setting affects explorations and funnel reports, while standard aggregated reports are unaffected.',
				rows: [
					['Price', 'Standard property available free', 'Free self-hosted option and paid plans'],
					['Revenue', 'Purchase and refund events you send', 'Payment webhooks with source credit when a visitor matches'],
					['Gateway fees', 'Reconcile separately', 'Uses actual fees when supported or estimates from the configured schedule'],
					['Setup', 'Google tag and ecommerce events', 'Tracker, checkout visitor ID and signed webhooks'],
					['User-level data retention', '2 or 14 months (standard properties)', 'You control retention in your self-hosted database'],
					['Browser storage', 'Analytics cookies when storage consent is granted', 'Random visitor ID in localStorage'],
					['Google Ads and Search Console', 'Built in', 'Not integrated'],
				],
				chooseThem: ['You buy Google Ads and need conversion data sent back to Google', 'You need Search Console, BigQuery export or audiences', 'You have an analyst who uses explorations and custom reports'],
				chooseUs: ['You want to compare net revenue per visitor by source', 'You want payment confirmations from a supported provider', 'You want to keep the analytics database in your own Cloudflare account'],
				pricing: [
					'Google Analytics 4 is free; Google Analytics 360 is the paid enterprise tier. The cost is in setup time: tags, events, key events and reports, and keeping consent rules right.',
					'Grosslytics offers a free self-hosted option on your own Cloudflare account. The free setup requires a “Powered by Grosslytics” link for dashboard access. Your Cloudflare usage determines any hosting costs.',
				],
				deep: [
					{
						h2: 'How each tool records a payment',
						ps: [
							'GA4 records a purchase when your integration sends a purchase event. Send a distinct transaction ID for each payment and include the value and currency. If you want renewals and refunds reflected in GA4, send those events from your billing integration too.',
							'Grosslytics starts with a signed payment webhook. Stripe Payment Links can carry a visitor ID automatically. With Checkout Sessions created on your server, pass the visitor ID when you create the session and include it in subscription metadata to match future invoices. A payment without a match can still appear as Unattributed.',
						],
					},
					{
						h2: 'How browser storage affects measurement',
						ps: [
							'Google’s Consent Mode can block tags before consent or load them with reduced data collection, depending on your setup. Grosslytics uses localStorage for its visitor ID. If that ID is cleared or unavailable at checkout, the payment may lose its link to the original visit. Review your consent setup for each tool.',
						],
					},
				],
				faqs: [
					{ question: 'Can I keep GA4 when I add Grosslytics?', answer: 'Yes. Keep GA4 for Google Ads conversions, audiences, Search Console and BigQuery. You can use Grosslytics for payment attribution alongside it.' },
					{ question: 'Can I take my revenue history with me?', answer: 'Grosslytics can import past Stripe payments with their original dates. Imported payments show as Unattributed when there is no recorded visit to match. Keep access to GA4 for existing reports.' },
					{ question: 'What happens if the browser clears the visitor ID?', answer: 'The payment can still arrive through a webhook. Grosslytics can match a returning buyer to a previous payment by email when available. If it cannot match the buyer, the payment appears as Unattributed.' },
				],
				theyLead: ['Free, with very deep reporting', 'Google Ads and Search Console integration', 'Industry-standard tooling and support'],
				weDiffer: ['Payment amounts from signed webhooks', 'Visitor IDs stored without cookies', 'Net revenue per visitor with provider fee estimates'],
				verified: '2026-11-21',
				sources: [
					{ label: 'GA4 purchase events', url: 'https://developers.google.com/analytics/devguides/collection/ga4/set-up-ecommerce' },
					{ label: 'GA4 data retention', url: 'https://support.google.com/analytics/answer/7667196' },
					{ label: 'Google Consent Mode', url: 'https://developers.google.com/tag-platform/security/concepts/consent-mode' },
					{ label: 'Grosslytics payment setup', url: '/docs/#payments' },
				],
			},
		},
	];
}

const { competitor, title, description, h1, answer, whatIs, rows, chooseThem, chooseUs, pricing, deep, faqs, theyLead, weDiffer, sources, verified: lastVerifiedDate } = Astro.props;
const related = [
	{ href: '/compare/datafast-alternative/', name: 'DataFast' },
	{ href: '/compare/databull-alternative/', name: 'DataBull' },
	{ href: '/compare/plausible-alternative/', name: 'Plausible' },
	{ href: '/compare/ga4-alternative/', name: 'Google Analytics 4' },
].filter((r) => r.name !== competitor);
const h2 = 'text-[28px] font-semibold tracking-[-0.02em] text-ink';
---

<Page title={title} description={description}>
	<Fragment slot="head">
		<SchemaJsonLd
			type="article"
			title={title}
			description={description}
			datePublished="2026-11-06"
			dateModified={lastVerifiedDate}
		/>
		<SchemaJsonLd type="faq" faqs={faqs} />
	</Fragment>

	<main>
		<article class="mx-auto max-w-[760px] px-5 pt-14 pb-20">
			<nav aria-label="Breadcrumb" class="mb-10 text-[13px] text-ink-3">
				<ol class="flex items-center gap-2">
					<li><a href="/" class="hover:text-ink">Home</a></li>
					<li aria-hidden="true">›</li>
				<li><a href="/compare/" class="hover:text-ink">Compare</a></li>
					<li aria-hidden="true">›</li>
					<li class="text-ink-2" aria-current="page">{competitor} alternative</li>
				</ol>
			</nav>

			<header>
				<p class="eyebrow mb-3">Grosslytics vs {competitor}</p>
				<h1 class="text-[clamp(36px,5.5vw,56px)] font-semibold leading-[1.06] tracking-[-0.035em]">{h1}</h1>
				<p class="mt-5 text-[21px] leading-relaxed text-ink-2">{answer}</p>
				<p class="mt-6 text-[13px] text-ink-3">
					Published by Grosslytics, which makes the product compared here · <time datetime={lastVerifiedDate}>Updated {lastVerifiedDate}</time>
				</p>
			</header>

			<section class="prose-g mt-14 text-[19px] leading-relaxed">
				<h2 class={h2}>What is {competitor}?</h2>
				<p>{whatIs}</p>
			</section>

			<section class="mt-14">
				<h2 class={h2}>{competitor} vs Grosslytics at a glance</h2>
				<div class="mt-6 overflow-x-auto rounded-[20px] ring-1 ring-line">
					<table class="w-full min-w-[520px] text-left text-[15px]">
						<thead>
							<tr class="bg-band text-[13px] text-ink-2">
								<th scope="col" class="px-5 py-3 font-medium">Capability</th>
								<th scope="col" class="px-5 py-3 font-medium">{competitor}</th>
								<th scope="col" class="px-5 py-3 font-semibold text-ink">Grosslytics</th>
							</tr>
						</thead>
						<tbody>
							{rows.map(([cap, them, us]) => (
								<tr class="border-t border-line">
									<th scope="row" class="px-5 py-3.5 font-normal text-ink-2">{cap}</th>
									<td class="px-5 py-3.5 text-ink-2">{them}</td>
									<td class="px-5 py-3.5 font-medium">{us}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="mt-4 text-[13px] leading-relaxed text-ink-3">
					Documentation for this comparison includes
					{sources.map((src, i) => <>{i > 0 ? ', ' : ' '}<a class="underline decoration-ink-3/40 hover:text-ink-2" href={src.url}>{src.label}</a></>)}.
				</p>
			</section>

			<section class="mt-14 grid gap-4 sm:grid-cols-2">
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Choose {competitor} if</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{chooseThem.map((f) => <li class="flex gap-3"><span class="text-ink-3" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Choose Grosslytics if</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{chooseUs.map((f) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
			</section>

			<section class="prose-g mt-14 text-[19px] leading-relaxed">
				<h2 class={h2}>{competitor} pricing vs Grosslytics pricing</h2>
				{pricing.map((p) => <p>{p}</p>)}
				<p>See <a href="/terms/">Grosslytics plan terms</a> for the conditions of each option.</p>
			</section>

			{deep.map((s) => (
				<section class="prose-g mt-14 text-[19px] leading-relaxed">
					<h2 class={h2}>{s.h2}</h2>
					{s.ps.map((p) => <p>{p}</p>)}
				</section>
			))}
		</article>

		<section class="bg-band px-5 py-20">
			<h2 class="mx-auto mb-10 max-w-[760px] text-center text-[28px] font-semibold tracking-[-0.02em]">Cost and margin calculator</h2>
			<RoiCalculator client:visible />
		</section>

		<article class="mx-auto max-w-[760px] px-5 py-20">
			<section class="grid gap-4 sm:grid-cols-2">
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where Grosslytics differs</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{weDiffer.map((f) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
				<div class="rounded-[24px] bg-band p-7">
					<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Where {competitor} is ahead</h2>
					<ul class="mt-4 space-y-2.5 text-[17px] text-ink-2">
						{theyLead.map((f) => <li class="flex gap-3"><span class="text-ink-3" aria-hidden="true">•</span>{f}</li>)}
					</ul>
				</div>
			</section>

			<section class="prose-g mt-16 text-[19px] leading-relaxed">
				<h2 class={h2}>How to verify revenue before switching</h2>
				<ol class="mt-4 list-decimal space-y-3 pl-6">
					<li>Keep your GA4 tag and key events running. <a href="/docs/#install">Add the Grosslytics tracker</a> to the landing page and connect a test checkout using the <a href="/blog/stripe-revenue-attribution/">Stripe setup guide</a>.</li>
					<li>Open a tagged test URL such as <code>?utm_source=qa&amp;utm_medium=referral</code> in a fresh browser session and complete a sandbox payment. In GA4 DebugView, confirm the purchase event has the expected transaction ID, value, and currency. In Grosslytics, check that the recorded sale is credited to <code>qa</code>.</li>
					<li>If GA4 has the event but Grosslytics shows Unattributed, check whether Stripe received the visitor ID. If only Grosslytics shows the payment, check the GA4 event delivery. Once both records appear, compare the same currency and reporting window, and reconcile the transaction against Stripe.</li>
					<li>Repeat the check for a renewal or refund if either affects how you report revenue. Keep GA4 in place if an Ads conversion or report still depends on it.</li>
				</ol>
				<p class="mt-4">See the <a href="/blog/track-chatgpt-traffic-revenue/">documented Stripe sandbox example</a> for a tagged visit matched to a payment in Grosslytics.</p>
			</section>

			<section class="prose-g mt-16 text-[19px] leading-relaxed">
				<h2 class={h2}>Why the two revenue reports can differ</h2>
				<p>Suppose a purchase is $100 before tax, the fee is $3, and you spend $20 on ads for the source. If you send a $100 purchase value to GA4, that event contributes $100 to purchase revenue. In Grosslytics, the payment is $97 net of fees. The separate profit figure is $77 after the ad spend you enter. These are illustrative amounts.</p>
				<p>Source credit can also differ. GA4’s Traffic acquisition report groups results by session source. Grosslytics first touch credits the visitor’s first recorded source. Choose the source view that matches the question you are answering. See <a href="https://support.google.com/analytics/answer/14731736">Google’s acquisition report guide</a> and the <a href="/docs/#dashboard">Grosslytics dashboard definitions</a>.</p>
			</section>

			<section class="mt-16 border-t border-line pt-12">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">{competitor} alternative: questions</h2>
				<div class="mt-4 divide-y divide-line">
					{faqs.map((faq) => (
						<details class="group py-5">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-semibold">
								<h3>{faq.question}</h3>
								<span class="text-[22px] font-light text-ink-3 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-[17px] leading-relaxed text-ink-2">{faq.answer}</p>
						</details>
					))}
				</div>
			</section>

			<nav aria-label="Other comparisons" class="mt-16">
				<h2 class="text-[21px] font-semibold tracking-[-0.02em]">Other comparisons</h2>
				<ul class="mt-4 grid gap-3 sm:grid-cols-3">
					{related.map((r) => (
						<li><a href={r.href} class="block rounded-2xl bg-band p-4 text-[15px] hover:ring-1 hover:ring-line"><span class="text-ink-3">Grosslytics vs</span><span class="mt-1 block font-semibold">{r.name} ›</span></a></li>
					))}
				</ul>
			</nav>

			<div class="mt-16 rounded-[28px] bg-band p-10 text-center">
				<h2 class="text-[28px] font-semibold tracking-[-0.02em]">See your own numbers.</h2>
				<p class="mt-2 text-ink-2">Free on your Cloudflare account.</p>
				<div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
					<a href="/start/" class="btn btn-primary">Start free</a>
					<a href="/app/demo" class="btn-quiet text-[17px]">Explore the live demo ›</a>
				</div>
			</div>
		</article>
	</main>
</Page>
