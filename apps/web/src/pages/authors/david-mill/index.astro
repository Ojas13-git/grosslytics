---
import Page from '../../../layouts/Page.astro';
import SchemaJsonLd from '../../../components/seo/SchemaJsonLd.astro';
import type { MarkdownInstance } from 'astro';

const mdItems = Object.values(import.meta.glob<MarkdownInstance<{ title: string; description: string }>>(['../../blog/*.md', '../../compare/*.md'], { eager: true })).map((article) => ({
	href: `${article.url}/`,
	title: article.frontmatter.title,
	description: article.frontmatter.description,
}));
const articles = [
	...mdItems,
	{
		href: '/compare/ga4-alternative/',
		title: 'Google Analytics 4 Alternative for SaaS Revenue Attribution',
		description: 'Compare Google Analytics 4 purchase events with Grosslytics payment webhooks. See what each tool measures and how to verify net revenue by channel.',
	},
].sort((a, b) => a.title.localeCompare(b.title));

const profile = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'David Mill',
	jobTitle: 'Founder',
	worksFor: { '@type': 'Organization', name: 'Grosslytics', url: 'https://grosslytics.com/' },
	url: 'https://grosslytics.com/authors/david-mill/',
	sameAs: ['https://www.linkedin.com/in/david-mill/', 'https://x.com/handancorp'],
};
const breadcrumbs = [
	{ name: 'Home', item: 'https://grosslytics.com/' },
	{ name: 'Blog', item: 'https://grosslytics.com/blog/' },
	{ name: 'David Mill', item: 'https://grosslytics.com/authors/david-mill/' },
];
---

<Page title="David Mill, Founder of Grosslytics" description="David Mill is the founder of Grosslytics. Find his revenue attribution and analytics implementation guides.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(profile)} />
		<SchemaJsonLd type="breadcrumb" breadcrumbs={breadcrumbs} />
	</Fragment>
	<main class="mx-auto max-w-3xl px-5 py-16">
		<p class="text-sm text-ink-2"><a href="/blog/" class="underline">Blog</a> / Author</p>
		<h1 class="mt-5 text-4xl font-semibold tracking-tight">David Mill</h1>
		<p class="mt-3 text-lg text-ink-2">Founder of Grosslytics</p>
		<p class="mt-6 leading-7">David Mill is the founder of Grosslytics. The articles below cover revenue attribution, analytics implementation and comparisons, including product capabilities, source documentation, and known limitations.</p>
		<ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
			<li><a class="underline" href="https://www.linkedin.com/in/david-mill/" rel="me">LinkedIn profile</a></li>
			<li><a class="underline" href="https://x.com/handancorp" rel="me">X profile (@handancorp)</a></li>
		</ul>
		<h2 class="mt-12 text-2xl font-semibold">Articles</h2>
		<ul class="mt-4">
			{articles.map((article) => (
				<li class="border-b border-line py-5">
					<h3 class="text-lg font-medium"><a class="underline" href={article.href}>{article.title}</a></h3>
					<p class="mt-2 text-ink-2">{article.description}</p>
				</li>
			))}
		</ul>
	</main>
</Page>
